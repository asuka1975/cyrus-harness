{
  "_comment": "表記の辞書。kana はひらく漢字（pattern は正規表現）、variants は1つの文書に混ざっていたら知らせる表記の組。読者に合わせて増やしてよい。補助動詞と形式名詞「事」「為」、硬い表現、冗長な表現の推敲は yomiyasu に任せる。",
  "kana": [
    {"pattern": "に於(い)?て", "suggest": "で／において", "reason": "漢字表記の副詞・助詞はひらく"},
    {"pattern": "且つ", "suggest": "かつ／そして", "reason": "接続詞はひらく"},
    {"pattern": "及び", "suggest": "と／および", "reason": "接続詞はひらく"},
    {"pattern": "並びに", "suggest": "と／また", "reason": "接続詞はひらく"},
    {"pattern": "若しくは", "suggest": "または", "reason": "接続詞はひらく"},
    {"pattern": "又は", "suggest": "または", "reason": "接続詞はひらく"},
    {"pattern": "即ち", "suggest": "つまり", "reason": "接続詞はひらく"},
    {"pattern": "(?<![\\u4e00-\\u9fff])尚(、|，)", "suggest": "なお", "reason": "接続詞はひらく"},
    {"pattern": "但し", "suggest": "ただし", "reason": "接続詞はひらく"},
    {"pattern": "予め", "suggest": "あらかじめ", "reason": "副詞はひらく"},
    {"pattern": "殆ど", "suggest": "ほとんど", "reason": "副詞はひらく"},
    {"pattern": "更に", "suggest": "さらに", "reason": "副詞はひらく"},
    {"pattern": "既に", "suggest": "すでに", "reason": "副詞はひらく"},
    {"pattern": "敢えて", "suggest": "あえて", "reason": "副詞はひらく"},
    {"pattern": "概ね", "suggest": "おおむね", "reason": "副詞はひらく"},
    {"pattern": "(?<![\\u4e00-\\u9fff])様々", "suggest": "さまざま", "reason": "ひらくと読みやすい"},
    {"pattern": "(て|で)欲しい", "suggest": "てほしい", "reason": "補助形容詞はひらく"},
    {"pattern": "(の|な)様(に|な|だ|です)", "suggest": "ように／ような", "reason": "形式名詞はひらく"},
    {"pattern": "(?<![\\u4e00-\\u9fff])迄", "suggest": "まで", "reason": "助詞はひらく"},
    {"pattern": "(?<![\\u4e00-\\u9fff])等(、|。|の|を|が|は|に|で)", "suggest": "など", "reason": "「など」とひらく"},
    {"pattern": "所謂", "suggest": "いわゆる", "reason": "ひらく"}
